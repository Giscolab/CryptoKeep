{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CryptoKeep",
  "identifier": "fr.giscolab.cryptokeep",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Gestionnaire de mots de passe local et chiffré",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "template": "windows/installer-preserve-data.nsi",
        "installMode": "currentUser",
        "languages": ["French"],
        "compression": "lzma"
      }
    }
  }
}
